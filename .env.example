# ============================================================
# Dipu's Edu — Environment Configuration Template (.env.example)
# Copy this file to .env and fill in real production values.
# NEVER commit the actual .env file with sensitive credentials.
# ============================================================

# Server Configuration
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000

# Security & Session
JWT_SECRET=super_secret_jwt_key_change_me_in_production
SESSION_SECRET=dipu_edu_session_concurrency_secret_key

# MongoDB Database (Atlas or Local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/dipu_edu?retryWrites=true&w=majority

# Bangladeshi SMS Gateway (BulkSMSBD / Greenweb / Elitbuzz)
SMS_GATEWAY_URL=https://api.bulksmsbd.com/send
SMS_API_KEY=your_bulksmsbd_api_key_here
SMS_SENDER_ID=DIPUEDU

# Google Gemini AI API (Gemini 2.5 Flash for Academic Mentor)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Cloudflare R2 Object Storage (Zero-Egress PDF & Assets)
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_key
CLOUDFLARE_R2_BUCKET_NAME=dipu-edu-materials
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://materials.dipusedu.com

# Mobile Financial Services (MFS) Gateways
# bKash Tokenized Checkout
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

# Nagad Merchant Gateway
NAGAD_MERCHANT_ID=your_nagad_merchant_id
NAGAD_PUBLIC_KEY=your_nagad_public_key
NAGAD_PRIVATE_KEY=your_nagad_private_key

# ZiniPay Payment Gateway (https://zinipay.com)
ZINIPAY_API_KEY=5afe9edc5f795f08013c2280de1028ecfa25ea0c9b774b1a
ZINIPAY_BASE_URL=https://api.zinipay.com

